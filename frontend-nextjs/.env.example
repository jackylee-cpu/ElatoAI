# When True every board gets a token for the shared admin account, which means
# "the account picks the character" does not work. Set False to make devices
# register themselves and be claimed from /home/settings.
# NOTE: NEXT_PUBLIC_* is inlined at build time -- changing it needs an image
# rebuild, not just a container restart.
NEXT_PUBLIC_SKIP_DEVICE_REGISTRATION=False

# Service role key. The device-facing API routes act for hardware that has no
# Supabase session, so they cannot use the cookie-backed client. Server only.
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# Reaching the voice server to drop a device session when its character changes.
# Prefer an address that does not leave the host: /internal/* must never be
# publicly routable.
VOICE_SERVER_INTERNAL_URL=http://fastapi:7860
INTERNAL_API_TOKEN=<SHARED_SECRET_MATCHING_THE_FASTAPI_ENV>

# Admins are no longer configured here. Roles live in the public.admin_roles
# table and need TOTP; see supabase/migrations/20261007180000_admin_roles.sql
# for granting the first super admin.

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
# Signs the 24-hour device tokens boards open the voice websocket with
# (lib/deviceAuth.ts). The voice server needs the same value to verify them.
# Must NOT be the Supabase JWT secret: a device token has to be useless to
# PostgREST. Generate one with `openssl rand -base64 48`.
DEVICE_JWT_SECRET=<YOUR_DEVICE_JWT_SECRET>

# (Optional) Encryption key for E2E encryption of API keys
# You can generate a random key with `openssl rand -base64 32`
ENCRYPTION_KEY=<YOUR_ENCRYPTION_KEY>

# OpenAI API key (used by the Playground when NEXT_PUBLIC_VOICE_BACKEND is not fastapi)
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# Use the FastAPI voice pipeline (Azure STT + OpenRouter + MiniMax) instead of OpenAI Realtime.
# Restart `next dev` after changing NEXT_PUBLIC_* values.
NEXT_PUBLIC_VOICE_BACKEND=fastapi
NEXT_PUBLIC_FASTAPI_WS_URL=ws://127.0.0.1:7860/ws/nextjs

# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Where /auth/callback redirects after sign-in (read at runtime, server only).
# Defaults to http://localhost:3000; set it on a deployment, e.g.
# SITE_URL=https://elatoai.hkqft.com

# Stripe
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<YOUR_STRIPE_PUBLISHABLE_KEY>
