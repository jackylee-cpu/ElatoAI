DEEPGRAM_API_KEY=your_deepgram_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key
XAI_API_KEY=your_xai_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
CARTESIA_API_KEY=your_cartesia_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# OpenRouter model ids use provider/model, e.g. openai/gpt-4o-mini or google/gemini-2.5-flash
# The admin page (/home/admin) overrides this in the app_settings table; what
# is set here is the default a fresh deployment starts on, and what it falls
# back to if that row is empty or unreadable.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Voice default: pick the lowest time-to-first-token provider.
# latency = fastest first token (best for speech)
# throughput / nitro = highest tokens/sec
# price = cheapest
# Also overridable from the admin page.
OPENROUTER_PROVIDER_SORT=latency
# Preferred OpenRouter hosts, tried first and in this order (comma-separated
# slugs, e.g. groq,akashml). Leave unset to let `sort` pick. Also overridable
# from the admin page.
# OPENROUTER_PROVIDER_ORDER=
# How hard the model should think before answering. Leave unset to use the
# model's own default (Gemma off, Qwen on/xhigh, gpt-oss medium and mandatory).
# none = off — gpt-oss rejects this; use low there.
# Also overridable from the admin page.
# OPENROUTER_REASONING_EFFORT=none
MINIMAX_API_KEY=your_minimax_api_key
# Group ID is on the same MiniMax console as the TTS key, not a separate vendor.
MINIMAX_GROUP_ID=your_minimax_group_id
# Optional: mainland China https://api.minimaxi.chat/v1/t2a_v2
# MiniMax's alternative endpoint, documented as the lower-TTFA one.
# The global endpoint is https://api.minimax.io/v1/t2a_v2 and the
# mainland one https://api.minimaxi.com/v1/t2a_v2; which is fastest is a
# property of where this server runs, so measure from the server before
# changing it, not from a laptop.
MINIMAX_BASE_URL=https://api-uw.minimax.io/v1/t2a_v2
# Transport for MiniMax TTS: websocket (default) says model, voice and
# format once per session instead of per sentence, and measured
# 886-1168ms faster per sentence. Set to http to fall back -- the one
# thing the websocket costs is a reconnect on barge-in, because the
# protocol has no cancel.
# MINIMAX_TTS_TRANSPORT=websocket
# MINIMAX_TTS_MODEL=speech-2.6-turbo
# MINIMAX_VOICE=Calm_Woman
# MINIMAX_LANGUAGE=zh

# Which language the toy speaks is not set here -- it comes from the account's
# language_code (the "Character's language" dropdown in Settings), and it picks
# the recognizer language, the MiniMax voice and the prompt instruction
# together. See server/fastapi/language_profiles.py.
#
# MINIMAX_VOICE / MINIMAX_LANGUAGE above are the fallback for an account whose
# language has no profile. The three below override the voice a profile picks,
# for a deployment that wants a different one without a code change. Run
# `POST https://api.minimax.io/v1/get_voice` with {"voice_type":"system"} for
# the full list; these are the defaults.
# MINIMAX_VOICE_YUE=Cantonese_KindWoman
#   other Cantonese voices: Cantonese_CuteGirl, Cantonese_GentleLady,
#   Cantonese_PlayfulMan, Cantonese_ProfessionalHost（F), Cantonese_ProfessionalHost（M)
# MINIMAX_VOICE_ZH=Chinese (Mandarin)_Warm_Girl
#   other Mandarin voices: Chinese (Mandarin)_Crisp_Girl,
#   Chinese (Mandarin)_Cute_Spirit, Chinese (Mandarin)_Sweet_Lady
# MINIMAX_VOICE_EN=English_Kind-heartedGirl
#   other English voices: English_Soft-spokenGirl, English_SereneWoman,
#   English_radiant_girl, English_FriendlyPerson

# Whisper STT in Pipecat is local/offline, so it does not require an API key.
# Default Whisper checkpoint is English-only; for Chinese talk sessions use:
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=zh
AZURE_SPEECH_API_KEY=your_azure_speech_api_key
AZURE_SPEECH_REGION=eastasia
# AZURE_SPEECH_LANGUAGE=zh-CN
# AZURE_SPEECH_PROFANITY=raw
# Silence before Azure finalizes a phrase, in ms (300-5000). Hands-free and
# mid-utterance pauses use this; push-to-talk force-finalizes on commit
# instead. Too low chops one sentence into multiple turns.
# AZURE_SPEECH_SILENCE_MS=2000
# AZURE_SPEECH_PRIVATE_ENDPOINT=
# AZURE_SPEECH_ENDPOINT_ID=

# Classic route providers
CURRENT_VOICE_ROUTE=classic
CLASSIC_STT_PROVIDER=deepgram
CLASSIC_LLM_PROVIDER=openai
CLASSIC_TTS_PROVIDER=elevenlabs

# OR + MX stack: Azure STT + OpenRouter LLM + MiniMax TTS
# CLASSIC_STT_PROVIDER=azure
# CLASSIC_LLM_PROVIDER=openrouter
# CLASSIC_TTS_PROVIDER=minimax

# Local Whisper fallback if you do not have an Azure Speech key:
# CLASSIC_STT_PROVIDER=whisper

# Transport and pipeline sample rates
ESP32_INPUT_SAMPLE_RATE=16000
BROWSER_INPUT_SAMPLE_RATE=16000
AUDIO_OUTPUT_SAMPLE_RATE=24000
PIPELINE_AUDIO_IN_SAMPLE_RATE=16000
PIPELINE_AUDIO_OUT_SAMPLE_RATE=24000

# Supabase, for resolving which character a device should run. The ESP32 sends
# its MAC in X-Device-Mac; the server looks up devices -> users -> personalities.
# Without these the device falls back to the built-in default character.
# Use the SERVICE ROLE key: the lookup runs for the device, not a logged-in user,
# so it has to bypass RLS. Keep it server-side only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Seconds to wait on that lookup before giving up and using defaults.
DEVICE_LOOKUP_TIMEOUT=3

# Fallbacks used when a device has no row of its own.
ESP32_DEFAULT_VOLUME=100
ESP32_DEFAULT_PITCH_FACTOR=1.0

# How long the site-wide settings row (app_settings.voice_stack, where the
# admin page keeps the LLM model) is cached before being re-read. Saving from
# the admin page also busts this cache via /internal/settings_refresh, so this
# is only the ceiling on how stale a setting can get if that call is lost.
APP_SETTINGS_CACHE_TTL=30
# Seconds to wait on that read. It runs before the first audio frame, so a slow
# database would be heard as the toy being slow to wake up. On timeout the
# session uses the env defaults above.
APP_SETTINGS_TIMEOUT=3

# Per-turn STT/LLM/TTS timings are written to the turn_metrics table using
# SUPABASE_SERVICE_ROLE_KEY above. The write is fire-and-forget and off the
# critical path, so it can afford to wait longer than a lookup.
TURN_METRICS_WRITE_TIMEOUT=10

# Shared secret guarding POST /internal/device_refresh (drop a device session so
# it reconnects as the newly picked character) and POST
# /internal/settings_refresh (re-read the model setting). Both are called by the
# web app. Must match INTERNAL_API_TOKEN in the Next.js env.
# Unset = both endpoints refuse everything.
INTERNAL_API_TOKEN=<SHARED_SECRET_MATCHING_THE_FRONTEND_ENV>

# Browser / Next.js access
ALLOWED_ORIGINS=*

# WebSocket server settings
HOST=0.0.0.0
PORT=7860

# ── Long-term memory ─────────────────────────────────────────────────────────
# The toy remembers the child across sessions. Memory is keyed by the account
# the device is claimed by, NOT by character: switching characters switches the
# personality, not who the toy is talking to.
#
# Every few turns, and when a session ends, one LLM call turns the raw turns
# into two things in Supabase: facts about the child (`memory_facts` -- name,
# pets, likes, dates) and a line about what you did together
# (`memory_segments`). The next session reads both straight into the system
# prompt, which is what lets the greeting already know them. Nothing is
# searched per turn.
#
# Requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above. Parents can read and
# delete what the toy knows in the web app's Settings page.
MEMORY_ENABLED=true

# Completed exchanges between summaries. Lower means less is lost if a session
# ends badly, at one LLM call per boundary.
MEMORY_SUMMARY_EVERY_TURNS=6

# How many past segments the opening brief carries. Two is roughly one session.
MEMORY_BRIEF_SEGMENTS=2
# Sessions shorter than this many turns are skipped for the brief when a longer
# one exists, so two sessions that only asked the time cannot push out the one
# that said the dog's name.
MEMORY_BRIEF_MIN_TURNS=3

# Facts about the child (name, pets, likes, dates) put in every system prompt.
# Newest are kept when there are more. They come out of the same LLM call as
# the summaries.
MEMORY_FACTS_IN_PROMPT=40

# Model that writes the summaries and extracts the facts. Defaults to
# OPENROUTER_MODEL, so a working OpenRouter key is enough. A reasoning model
# here makes every summary take tens of seconds; the one below answers in 1-4s.
MEMORY_SUMMARY_MODEL=deepseek/deepseek-v4-flash
# Applies only when MEMORY_SUMMARY_MODEL is set. "off" asks OpenRouter not to
# reason on these calls.
MEMORY_SUMMARY_REASONING=off

# Caps, in characters, on one summary and on the running one injected per turn.
MEMORY_SEGMENT_MAX_CHARS=220
MEMORY_SESSION_SUMMARY_MAX_CHARS=400

# How many exchanges stay in the prompt verbatim. Older turns are covered by
# the running summary instead. 0 disables trimming and lets the context grow
# for the whole session.
MEMORY_MAX_HISTORY_TURNS=8

# The default place for the date, time and weather in the system prompt (see
# world_context.py). An account that picked "Where you live" in Settings gets
# its own region instead; these cover every account that has not. Weather
# comes from Open-Meteo and needs no key.
# LOCAL_TIMEZONE=Asia/Hong_Kong
# WEATHER_PLACE=Hong Kong
# WEATHER_LATITUDE=22.3193
# WEATHER_LONGITUDE=114.1694
# WEATHER_ENABLED=true
