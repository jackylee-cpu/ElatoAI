DEEPGRAM_API_KEY=your_deepgram_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key
XAI_API_KEY=your_xai_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
CARTESIA_API_KEY=your_cartesia_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# OpenRouter model ids use provider/model, e.g. openai/gpt-4o-mini or google/gemini-2.5-flash
OPENROUTER_MODEL=openai/gpt-4o-mini
# Voice default: pick the lowest time-to-first-token provider.
# latency = fastest first token (best for speech)
# throughput / nitro = highest tokens/sec
# price = cheapest
OPENROUTER_PROVIDER_SORT=latency
MINIMAX_API_KEY=your_minimax_api_key
# Group ID is on the same MiniMax console as the TTS key, not a separate vendor.
MINIMAX_GROUP_ID=your_minimax_group_id
# Optional: mainland China https://api.minimaxi.chat/v1/t2a_v2
# MINIMAX_BASE_URL=https://api.minimax.io/v1/t2a_v2
# MINIMAX_TTS_MODEL=speech-2.6-turbo
# MINIMAX_VOICE=Calm_Woman
# MINIMAX_LANGUAGE=zh
# Whisper STT in Pipecat is local/offline, so it does not require an API key.
# Default Whisper checkpoint is English-only; for Chinese talk sessions use:
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=zh
AZURE_SPEECH_API_KEY=your_azure_speech_api_key
AZURE_SPEECH_REGION=eastasia
# AZURE_SPEECH_LANGUAGE=zh-CN
# AZURE_SPEECH_PROFANITY=raw
# Silence before Azure finalizes a phrase, in ms (300-5000). Too low chops
# one sentence into multiple turns; 600ms is the default.
# AZURE_SPEECH_SILENCE_MS=600
# AZURE_SPEECH_PRIVATE_ENDPOINT=
# AZURE_SPEECH_ENDPOINT_ID=

# Classic route providers
CURRENT_VOICE_ROUTE=classic
CLASSIC_STT_PROVIDER=deepgram
CLASSIC_LLM_PROVIDER=openai
CLASSIC_TTS_PROVIDER=elevenlabs

# OR + MX stack: Azure STT + OpenRouter LLM + MiniMax TTS
# CLASSIC_STT_PROVIDER=azure
# CLASSIC_LLM_PROVIDER=openrouter
# CLASSIC_TTS_PROVIDER=minimax

# Local Whisper fallback if you do not have an Azure Speech key:
# CLASSIC_STT_PROVIDER=whisper

# Transport and pipeline sample rates
ESP32_INPUT_SAMPLE_RATE=16000
BROWSER_INPUT_SAMPLE_RATE=16000
AUDIO_OUTPUT_SAMPLE_RATE=24000
PIPELINE_AUDIO_IN_SAMPLE_RATE=16000
PIPELINE_AUDIO_OUT_SAMPLE_RATE=24000

# Supabase, for resolving which character a device should run. The ESP32 sends
# its MAC in X-Device-Mac; the server looks up devices -> users -> personalities.
# Without these the device falls back to the built-in default character.
# Use the SERVICE ROLE key: the lookup runs for the device, not a logged-in user,
# so it has to bypass RLS. Keep it server-side only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Seconds to wait on that lookup before giving up and using defaults.
DEVICE_LOOKUP_TIMEOUT=3

# Fallbacks used when a device has no row of its own.
ESP32_DEFAULT_VOLUME=100
ESP32_DEFAULT_PITCH_FACTOR=1.0

# Shared secret guarding POST /internal/device_refresh, which the web app calls
# to drop a device session so it reconnects as the newly picked character.
# Must match INTERNAL_API_TOKEN in the Next.js env. Unset = endpoint refuses all.
INTERNAL_API_TOKEN=<SHARED_SECRET_MATCHING_THE_FRONTEND_ENV>

# Browser / Next.js access
ALLOWED_ORIGINS=*

# WebSocket server settings
HOST=0.0.0.0
PORT=7860

# ── Long-term memory (VoiceMem) ──────────────────────────────────────────────
# The toy remembers the child across sessions. Memory is keyed by the account
# the device is claimed by, NOT by character: switching characters switches the
# personality, not who the toy is talking to.
#
# Requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above -- Supabase holds the
# durable copy, because the container's disk does not survive a restart.
# Parents can read and delete memories in the web app's Settings page.
VOICEMEM_ENABLED=true

# Where the working stores live, one subdirectory per child. Mount a volume
# here to save re-downloading snapshots on every restart; it is a cache, not
# the source of truth, so losing it costs a download, not the memories.
#
# NOTE: do NOT set VOICEMEM_MEMORY_ROOT. VoiceMem reads that name itself and it
# overrides the per-child directory, which would put every child into one
# shared store.
VOICEMEM_BASE_DIR=./voicemem_spaces

# How many memories to retrieve per turn.
VOICEMEM_TOP_K=5

# How long the final transcript may wait for a lookup that started while the
# child was still speaking. 0 (the default) means never wait: barge-in on this
# pipeline is already fragile, and stalling the frame path makes it worse.
# Raise only after measuring the barge-in drop rate.
VOICEMEM_SEARCH_BLOCK_MS=0

# Run VoiceMem's Classify() before the search. Better slot targeting, but it is
# an extra LLM round trip and most of the 1-2s a lookup can take.
VOICEMEM_CLASSIFY=false

# How many children's stores stay warm in memory at once.
VOICEMEM_MAX_SESSIONS=32

# Private Supabase Storage bucket holding one snapshot per child.
VOICEMEM_BUCKET=voicemem
