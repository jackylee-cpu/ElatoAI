DEEPGRAM_API_KEY=your_deepgram_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key
XAI_API_KEY=your_xai_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
CARTESIA_API_KEY=your_cartesia_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# OpenRouter model ids use provider/model, e.g. openai/gpt-4o-mini or google/gemini-2.5-flash
OPENROUTER_MODEL=openai/gpt-4o-mini
# Voice default: pick the lowest time-to-first-token provider.
# latency = fastest first token (best for speech)
# throughput / nitro = highest tokens/sec
# price = cheapest
OPENROUTER_PROVIDER_SORT=latency
MINIMAX_API_KEY=your_minimax_api_key
# Group ID is on the same MiniMax console as the TTS key, not a separate vendor.
MINIMAX_GROUP_ID=your_minimax_group_id
# Optional: mainland China https://api.minimaxi.chat/v1/t2a_v2
# MINIMAX_BASE_URL=https://api.minimax.io/v1/t2a_v2
# MINIMAX_TTS_MODEL=speech-2.6-turbo
# MINIMAX_VOICE=Calm_Woman
# MINIMAX_LANGUAGE=zh
# Whisper STT in Pipecat is local/offline, so it does not require an API key.
# Default Whisper checkpoint is English-only; for Chinese talk sessions use:
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=zh
AZURE_SPEECH_API_KEY=your_azure_speech_api_key
AZURE_SPEECH_REGION=eastasia
# AZURE_SPEECH_LANGUAGE=zh-CN
# AZURE_SPEECH_PROFANITY=raw
# Lower = faster finals (100-5000). 200ms is the low-latency default.
# AZURE_SPEECH_SILENCE_MS=200
# AZURE_SPEECH_PRIVATE_ENDPOINT=
# AZURE_SPEECH_ENDPOINT_ID=

# Classic route providers
CURRENT_VOICE_ROUTE=classic
CLASSIC_STT_PROVIDER=deepgram
CLASSIC_LLM_PROVIDER=openai
CLASSIC_TTS_PROVIDER=elevenlabs

# OR + MX stack: Azure STT + OpenRouter LLM + MiniMax TTS
# CLASSIC_STT_PROVIDER=azure
# CLASSIC_LLM_PROVIDER=openrouter
# CLASSIC_TTS_PROVIDER=minimax

# Local Whisper fallback if you do not have an Azure Speech key:
# CLASSIC_STT_PROVIDER=whisper

# Transport and pipeline sample rates
ESP32_INPUT_SAMPLE_RATE=16000
BROWSER_INPUT_SAMPLE_RATE=16000
AUDIO_OUTPUT_SAMPLE_RATE=24000
PIPELINE_AUDIO_IN_SAMPLE_RATE=16000
PIPELINE_AUDIO_OUT_SAMPLE_RATE=24000

# Browser / Next.js access
ALLOWED_ORIGINS=*

# WebSocket server settings
HOST=0.0.0.0
PORT=7860
